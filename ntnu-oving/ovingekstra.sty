% ovingekstra.sty, tillegg til NTNUoving.cls og NTNUlf.cls
%
% Lastes oppå den offisielle NTNU-klassen og legger til hint med samlet
% hintliste, litteraturtabell, bolkoverskrifter, løsningsblokker som bare
% vises med NTNUlf, navngitte delspørsmål og Open Sans. Selve klassen er
% urørt. Se README.md for bruk.
%
% Bruk i dokumentet:
%   \documentclass[11pt,a4paper,norsk]{NTNUoving}   % oppgavesett
%   %\documentclass[11pt,a4paper,norsk]{NTNUlf}      % løsningsforslag
%   \usepackage{ovingekstra}

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ovingekstra}[2026/10/08 Tillegg til NTNUoving]

\RequirePackage[T1]{fontenc}
% NTNUs hovedskrift er Open Sans, jf. i.ntnu.no/wiki/-/wiki/Norsk/NTNUs+skrifttype
\RequirePackage[default,scale=0.95]{opensans}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{etoolbox}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{needspace}

% Språkhjelper. \languagename er «norsk» eller «english» avhengig av
% klasseopsjonen, og styrer de faste tekstene i malen.
\newcommand{\ovm@sprak}[2]{\ifdefstring{\languagename}{english}{#2}{#1}}

% Litt slingringsmonn i linjebrytingen, ellers stikker enkelte lange
% sammensatte ord ut i høyremargen.
\tolerance=2000
\emergencystretch=2em

% Løsningsmodus følger klassen. NTNUlf = løsningsforslag.
\newif\ifovm@losning
\@ifclassloaded{NTNUlf}{\ovm@losningtrue}{}

% NTNUlf setter «Løsningsforslag --- Øving». Vi bruker ikke tankestrek i
% dokumentene, så etiketten overstyres her og klassen forblir urørt.
\ifovm@losning
  \addto\extrasnorsk{\def\OVING{L{\o}sningsforslag til {\o}ving}}%
  \addto\extrasnynorsk{\def\OVING{L{\o}ysingsforslag til {\o}ving}}%
\fi

% -- Øvingstime og innlevering ------------------------------------
% Setterne beholdes så øvingsfilene kan kalle dem, men datoene vises
% ikke lenger noe sted i malen. Konkrete datoer på et utdelt ark gjør
% det lett å avsløre gjenbruk år for år, jf. tilbakemelding fra faglærer.
\newcommand{\ovm@stime}{}
\newcommand{\ovm@innl}{}
\newcommand{\ovingstime}[1]{\renewcommand{\ovm@stime}{#1}}
\newcommand{\innlevering}[1]{\renewcommand{\ovm@innl}{#1}}

% Klassens tittelblokk i hodet er en 0.4\textwidth parbox som brekker
% lange emnetitler stygt. Vi utvider høyre blokk og gir logoblokken en
% smalere parbox, så tittelen får mer plass. (@ er allerede bokstav i sty.)
\def\@m@ketitle{%
  \vskip 2mm
  \hbox to\textwidth{\kern4mm
    \vtop{\null\hbox{\NTNULogo}}\hfill
    \vtop{\null\hbox{\parbox{0.74\textwidth}{%
      \Large \raggedleft \@title \par}}}%
    \kern4mm}%
  \vskip 0.5em}
\renewcommand{\NTNULogo}{%
  \parbox[b]{0.20\textwidth}{%
    \includegraphics[width=2cm]{\logofil}}%
}

% Det løpende hodet side to og utover holdes tomt, og datostempelet
% (\today) som klassen setter midt i bunnteksten fjernes. «Øving N» skal
% stå ett sted, i den sentrerte tittelblokken under rammen, og ingen
% datoer skal ut på arket.
\def\innerhead{}
\def\outerhead{}
\def\centerfoot{}

% -- Sentrert tittelblokk under hodet -----------------------------
% Klassen har ingen emnetittel under rammen, så den legges her.
% \OVING gir «Øving» eller «Løsningsforslag til øving» avhengig av klasse.
\newcommand{\ovingtittel}[1]{\renewcommand{\ovm@tittel}{#1}}
\newcommand{\ovm@tittel}{}
\newcommand{\ovingnummer}[1]{\renewcommand{\ovm@nr}{#1}\ovingnr{#1}}
\newcommand{\ovm@nr}{}
\newcommand{\ovingtittelblokk}{%
  \begin{center}
    {\large\bfseries \OVING\space\ovm@nr}\\[0.2em]
    {\large\bfseries \ovm@tittel}
  \end{center}
  \vspace{0.5em}
}

% -- Oppgaver og hint ---------------------------------------------
% \oppgave{tekst} beholdes som kommandoform (dokumentene er skrevet
% slik). Nummeret settes i ramme som i klassens oppgave-miljø.
% Klassen definerer «oppgave» som et list-miljø. Dokumentene bruker
% kommandoformen \oppgave{...}, så vi overstyrer med \renewcommand.
% Nummeret står i venstremargen, teksten har hengende innrykk så
% etterfølgende linjer flukter under første linje, ikke under nummeret.
\newcounter{ekstraoppg}
\newcounter{hint}[ekstraoppg]
\newlength{\ovm@oppginnrykk}\setlength{\ovm@oppginnrykk}{2.4em}
% Hele oppgaven settes i en list, som i klassens eget oppgave-miljø, så
% alle avsnitt får samme venstre innrykk og nummeret henger til venstre.
\renewcommand{\oppgave}[1]{%
  \par\addvspace{0.5\baselineskip}%
  \refstepcounter{ekstraoppg}%
  \begingroup
    \setlength{\leftmargini}{\ovm@oppginnrykk}%
    \begin{list}{}{%
      \setlength{\leftmargin}{\ovm@oppginnrykk}%
      \setlength{\labelwidth}{\ovm@oppginnrykk}%
      \setlength{\labelsep}{0.6em}%
      \setlength{\itemindent}{0pt}%
      \setlength{\listparindent}{0pt}%
      \setlength{\topsep}{0pt}\setlength{\parsep}{\parskip}}%
      \item[\fbox{\sffamily\large\theekstraoppg}]#1
    \end{list}%
  \endgroup
}
% Fjern miljø-enden som fulgte med det gamle oppgave-miljøet.
\let\endoppgave\relax

\def\ovm@hintrows{}
% Valgfritt for nye øvinger, endrer ikke øvinger som ikke bruker dem:
%   \hinttittel{tekst}  overskrift over hinttabellen (standard «Hint til øvingen»)
%   \hintkolonner       tabell med kolonnene «Hint 1» og «Hint 2», slik
%                       kildedokumentene har det. Krever to \hint per oppgave.
\newcommand{\ovm@hinttittel}{\ovm@sprak{Hint til øvingen}{Hints}}
\newcommand{\hinttittel}[1]{\renewcommand{\ovm@hinttittel}{#1}}
\newif\ifovm@hintpar
\newcommand{\hintkolonner}{\ovm@hintpartrue}
%   \hintliste          hintene som nummerert liste («1. tekst») i stedet
%                       for tabell, for kilder med ett hint per oppgave.
\newif\ifovm@hintliste
\newcommand{\hintliste}{\ovm@hintlistetrue}
\def\ovm@hintforste{}
\newcommand{\hint}[1]{%
  \refstepcounter{hint}%
  \ifovm@hintliste
    \xappto\ovm@hintrows{\noexpand\item[\arabic{ekstraoppg}.]~\unexpanded{#1}}%
  \else\ifovm@hintpar
    \ifnumequal{\value{hint}}{1}%
      {\xdef\ovm@hintforste{\arabic{ekstraoppg})~\unexpanded{#1}}}%
      {\xappto\ovm@hintrows{%
         \expandonce\ovm@hintforste & \arabic{ekstraoppg})~\unexpanded{#1} \noexpand\\[2pt]}}%
  \else
    \xappto\ovm@hintrows{%
      \ifnumequal{\value{hint}}{1}{\noexpand\textbf{\arabic{ekstraoppg}}}{} &
      \noexpand\textbf{\arabic{hint})}~\unexpanded{#1} \noexpand\\[2pt]
    }%
  \fi\fi
}
\newcommand{\hinttabell}{%
  \ifdefempty{\ovm@hintrows}{}{%
    \section*{\ovm@hinttittel}
    \ifovm@hintliste
      \begin{list}{}{\setlength{\leftmargin}{2em}\setlength{\labelwidth}{1.6em}%
        \setlength{\labelsep}{0.4em}\setlength{\itemsep}{2pt}}
        \ovm@hintrows
      \end{list}%
    \else
    \renewcommand{\arraystretch}{1.2}%
    \noindent
    \ifovm@hintpar
      \begin{tabularx}{\textwidth}{@{}X X@{}}
        \toprule
        \textbf{Hint 1} & \textbf{Hint 2} \\
        \midrule
        \ovm@hintrows
        \bottomrule
      \end{tabularx}%
    \else
      \begin{tabularx}{\textwidth}{@{}c X@{}}
        \toprule
        \textbf{\ovm@sprak{Oppgave}{Exercise}} & \textbf{\ovm@sprak{Hint}{Hint}} \\
        \midrule
        \ovm@hintrows
        \bottomrule
      \end{tabularx}%
    \fi
    \fi
  }%
}

% -- Løsning (vises kun når NTNUlf er lastet) ---------------------
% \losningsetikett{tekst} endrer etiketten foran hvert svar, f.eks. til
% «Mulig svar:» som i kildedokumentet. Standard er «Løsningsforslag.».
\newcommand{\ovm@losetikett}{\ovm@sprak{Løsningsforslag.}{Solution.}}
\newcommand{\losningsetikett}[1]{\renewcommand{\ovm@losetikett}{#1}}
\newcommand{\losning}[1]{%
  \ifovm@losning
    \par\vspace{4pt}\noindent
    {\bfseries\ovm@losetikett}\quad #1\par\vspace{4pt}%
  \fi
}

% -- Bolk-overskrift (Begrep, Innsikt, Anvendelse) ----------------
% Fet skrift, i tråd med klassens \oppgaveoverskrift.
% \needspace hindrer at bolk-tittelen blir stående alene nederst på en
% side. Er det ikke plass til tittelen pluss starten av første oppgave,
% flyttes hele blokken til neste side.
\newcommand{\bolk}[1]{%
  \par\addvspace{1.2\baselineskip}%
  \needspace{5\baselineskip}%
  {\large\bfseries #1}%
  \par\nobreak\vspace{0.3\baselineskip}\nobreak%
}

% -- Litteraturtabell ---------------------------------------------
% Forfatter til venstre, referanse til høyre. Skill rader med \\ \midrule.
% \forfatterbredde{0.40} gjør forfatterkolonnen bredere (andel av tekstbredden).
% Standard 0.30, så øvinger som ikke setter den er uendret.
\newcommand{\ovm@forfatterbredde}{0.30}
\newcommand{\forfatterbredde}[1]{\renewcommand{\ovm@forfatterbredde}{#1}}
\newenvironment{litteratur}
  {\par\vspace{0.4em}\noindent
   \tabularx{\textwidth}{@{}>{\raggedright\arraybackslash}p{\ovm@forfatterbredde\textwidth} X@{}}
   \toprule}
  {\bottomrule\endtabularx\par\vspace{0.4em}}

% -- Navngitt delspørsmål ("Spørsmål a.") -------------------------
\newcommand{\sporsmaal}[1]{%
  \par\vspace{6pt}\noindent{\bfseries\ovm@sprak{Spørsmål}{Question}\ #1.}\par\nopagebreak\vspace{2pt}%
}

\endinput
